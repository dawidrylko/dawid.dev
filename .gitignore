# Materialized upstream quartz files are excluded via .git/info/exclude,
# generated by scripts/assemble.sh from its manifest — NOT here. Quartz's
# build globs honor .gitignore (globby gitignore: true), so listing
# materialized paths here would silently drop them from the build.

# --- build outputs & local state ---
/.quartz-dist/
/node_modules/
/public/
.quartz-cache/
tsconfig.tsbuildinfo
prof/
.DS_Store
.obsidian
private/

# Lokalny stan narzędzi agentowych. Wymienione po nazwie, nie całym katalogiem,
# żeby ewentualny współdzielony .claude/settings.json pozostał widoczny w gicie.
.claude/settings.local.json
.claude/launch.json
.claude/worktrees/
.claude/.cc-writes/
